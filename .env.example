# Copy to .env for local use. On Netlify, add these under Site configuration > Environment variables.
ADMIN_PASSWORD_SHA256=            # output of: npm run hash -- "your password"
SESSION_SECRET=                   # any long random string (32+ characters)
APPS_SCRIPT_URL=                  # the Web app URL from the Apps Script deployment (recommended storage)
APPS_SCRIPT_TOKEN=                # the same token pasted into apps-script/Code.gs
# Alternative storage (Google Cloud service account), used only if the two lines above are empty:
GOOGLE_SHEET_ID=                  # the long id in the Google Sheet URL
GOOGLE_SERVICE_ACCOUNT_JSON=      # the whole service-account JSON key, pasted as one value
ALLOWED_ORIGINS=https://va-academy.netlify.app   # sites allowed to post leads; comma-separated
# LOCAL_STORE=1                   # local testing only: keep data in ./.data instead of Google Sheets
